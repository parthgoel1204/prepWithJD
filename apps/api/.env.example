# Express API configuration (copy to apps/api/.env and fill in)
# MongoDB Atlas free cluster connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prepwithjd?retryWrites=true&w=majority

# Brave Search API key (optional for Day 1 — search degrades gracefully without it)
# Get one free at https://brave.com/search/api/
BRAVE_API_KEY=

# Session cookie
SESSION_NAME=sid
SESSION_TTL_DAYS=7

# Server
API_PORT=4000
NODE_ENV=development

# Retrieval: allow crawling loopback/private URLs during local dev (batch CLI tests a
# locally served site). Leave OFF in production.
ALLOW_PRIVATE_URLS=true